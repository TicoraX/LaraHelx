{
  "info": {
    "name": "LaraHelx API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://laravel.helx.page"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "artistId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y token', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tu-correo@ejemplo.com\",\n  \"password\": \"tu-clave\",\n  \"device_name\": \"Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "tokens"
          ]
        }
      }
    },
    {
      "name": "Listar artistas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists"
          ]
        }
      }
    },
    {
      "name": "Ver artista",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists/{{artistId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists",
            "{{artistId}}"
          ]
        }
      }
    },
    {
      "name": "Crear artista",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('artistId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Artista de prueba\",\n  \"country\": \"Colombia\",\n  \"genre\": \"Rock\",\n  \"bio\": \"Creado desde Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists"
          ]
        }
      }
    },
    {
      "name": "Actualizar artista",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Artista editado\",\n  \"country\": \"Colombia\",\n  \"genre\": \"Rock\",\n  \"bio\": \"Creado desde Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists/{{artistId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists",
            "{{artistId}}"
          ]
        }
      }
    },
    {
      "name": "Eliminar artista",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists/{{artistId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists",
            "{{artistId}}"
          ]
        }
      }
    },
    {
      "name": "Listar sin token (401)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/artists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "artists"
          ]
        }
      }
    }
  ]
}
